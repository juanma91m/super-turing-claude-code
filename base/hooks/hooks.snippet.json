{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/env-guard.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/sensitive-reference-guard.sh"
          }
        ]
      }
    ]
  }
}
